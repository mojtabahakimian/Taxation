<Window x:Class="Prg_Grpsend.WIN_BULKWARNINGS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="هشدارهای پیش از ارسال"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource IRANYEKAN}"
        Width="1100" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- توضیح -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TXT_SUMMARY" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555" FontSize="13"
                       Text="فاکتورهای تیک‌خورده ارسال می‌شوند. تیک هر فاکتوری را که نمی‌خواهید بفرستید بردارید. فاکتورهای بدون هشدار در هر حال ارسال می‌شوند."/>
        </StackPanel>

        <!-- انتخاب گروهی -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <Button x:Name="BTN_ALL" Content="انتخاب همه" Click="BTN_ALL_Click" Margin="0,0,8,4"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button x:Name="BTN_NONE" Content="برداشتن همه" Click="BTN_NONE_Click" Margin="0,0,24,4"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <TextBlock Text="نوع هشدار:" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <ComboBox x:Name="CMB_KIND" MinWidth="260" Margin="0,0,8,4" VerticalAlignment="Center"
                      DisplayMemberPath="Title"/>
            <Button x:Name="BTN_KIND_OFF" Content="برداشتن تیک این نوع" Click="BTN_KIND_OFF_Click" Margin="0,0,8,4"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button x:Name="BTN_KIND_ON" Content="تیک‌زدن این نوع" Click="BTN_KIND_ON_Click" Margin="0,0,8,4"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </WrapPanel>

        <!-- فهرست -->
        <DataGrid x:Name="DG_WARNINGS" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="ارسال" Width="70" SortMemberPath="Send">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding Send, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding Number}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="نوع هشدار" Binding="{Binding Kinds}" IsReadOnly="True" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="شرح" Binding="{Binding Messages}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- تصمیم -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="TXT_COUNT" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14"/>
            <Button x:Name="BTN_CANCEL" DockPanel.Dock="Left" Content="لغو کل ارسال" Click="BTN_CANCEL_Click"
                    Margin="8,0,0,0" Width="150" Height="40"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button x:Name="BTN_SEND" DockPanel.Dock="Left" Content="ارسال تیک‌خورده‌ها" Click="BTN_SEND_Click"
                    Width="190" Height="40" IsDefault="True"/>
        </DockPanel>
    </Grid>
</Window>
