<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.0.143" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.1" />
    <PackageReference Include="TaxCollectData.Library" Version="0.0.34" />
  </ItemGroup>


  <ItemGroup>
    <!-- هارنس تست محلی (TestTools/LocalMoadian) به اعضای internal دسترسی دارد
         تا بتواند رفتار داخلی را قفل کند بدون اینکه چیزی public شود. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MoadianLocalTest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
